{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridiona-website",
  "main": "worker.js",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // An allowlist, NOT `true`. `true` invokes worker.js for every single
    // request — all ~25 subresources of one landing-page view (CSS, JS, fonts,
    // logos, favicons, the /demo iframe and its own assets) — and each one
    // counts against the Workers free plan's 100k requests/day, which it blew
    // past. Requests served straight off the static-asset store are free and
    // unlimited, so only the paths that genuinely need Worker logic are listed:
    //
    //   /dl, /download            attribution + interstitial
    //   /subscribe, /waitlist     Resend POST handlers
    //   /writing, /writing/*      per-essay <title>/description/nav rewriting
    //   /auth/*, /webhooks/*      auth.meridiona.com Google-SSO relay + Clerk
    //
    // "/" is deliberately absent: worker.js does nothing for it but fall
    // through to env.ASSETS.fetch(), and it's the single biggest saving.
    //
    // Trade-off this buys: assets served this way skip withSecurityHeaders(),
    // so the same baseline is restated in the `_headers` file at the repo root.
    // Change one, change the other. The www.meridiona.com -> apex 301 in
    // worker.js also stops firing (these patterns are path-only, not
    // host-aware) and is handled by a Cloudflare Single Redirect rule instead.
    "run_worker_first": [
      "/dl",
      "/download",
      "/subscribe",
      "/waitlist",
      "/dev",
      "/dev/*",
      "/writing",
      "/writing/*",
      "/auth/*",
      "/webhooks/*"
    ],
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Lets Workers Builds generate a branch/commit preview URL (<branch>-meridiona-website.<subdomain>.workers.dev)
  // and post it as a PR comment. Also requires "Builds for non-production branches"
  // to be turned on under the Worker's Settings > Build > Branch control in the
  // Cloudflare dashboard — that toggle lives outside this repo.
  "preview_urls": true,
  // Clerk publishable key for the Google-SSO relay (auth.meridiona.com) — a
  // public identifier, safe to commit (unlike CLERK_SECRET_KEY, which is a
  // `wrangler secret put` value, never checked in). authenticateRequest()
  // needs both keys to resolve the satellite-domain handshake correctly.
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_dG91Y2hpbmctdW5pY29ybi0xNS5jbGVyay5hY2NvdW50cy5kZXYk"
  },
  // Custom domains served by this Worker. `custom_domain: true` makes wrangler
  // provision the DNS record + edge certificate on deploy (the meridiona.com
  // zone must live on the same Cloudflare account).
  //
  // meridiona.com (the apex — the main website) MUST stay listed here. When a
  // `routes` array is present, wrangler treats it as the Worker's complete set
  // of custom domains and detaches any not listed; leaving the apex out drops
  // its custom-domain DNS record and takes the site down.
  "routes": [
    {
      "pattern": "meridiona.com",
      "custom_domain": true
    },
    {
      // www → apex; the Worker 301-redirects it (see worker.js) so there's a
      // single canonical host. custom_domain provisions its DNS record + cert.
      "pattern": "www.meridiona.com",
      "custom_domain": true
    },
    {
      // Google-SSO relay for the Meridian desktop app (see worker.js).
      "pattern": "auth.meridiona.com",
      "custom_domain": true
    }
  ],
  // One-time-token store for the auth.meridiona.com Google-SSO relay (see
  // worker.js's /auth/callback + /auth/exchange routes) — short-TTL entries,
  // deleted on first read. Created via `wrangler kv namespace create AUTH_TOKENS`.
  "kv_namespaces": [
    {
      "binding": "AUTH_TOKENS",
      "id": "05edf1c41eb842fa8caf7de0536495d9"
    }
  ]
}
